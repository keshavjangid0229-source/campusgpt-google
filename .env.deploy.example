CAMPUSGPT_DOMAIN=
CAMPUSGPT_USER=campus
# Keep the single quotes around the bcrypt hash so dollar signs stay literal.
CAMPUSGPT_PASSWORD_HASH=''

# Choose xai, groq, openrouter, openai, or gemini and fill in only its key.
CAMPUSGPT_AI_PROVIDER=xai
XAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional Google sign-in. The callback is /api/campus/auth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CAMPUSGPT_SESSION_SECRET=
CAMPUSGPT_CREATOR_NAME=Keshav Jangid
