# Use auto, xai, openrouter, openai, or gemini.
# Auto selects the first configured key in the order shown below.
CAMPUSGPT_AI_PROVIDER=auto
OPENROUTER_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional Google sign-in for the local preview.
CAMPUSGPT_PUBLIC_URL=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CAMPUSGPT_SESSION_SECRET=
CAMPUSGPT_CREATOR_NAME=Keshav Jangid

# Optional provider-specific model overrides.
# OPENROUTER_MODEL=openrouter/auto
# XAI_MODEL=grok-4.7
# OPENAI_MODEL=gpt-4.1-mini
# GEMINI_MODEL=gemini-2.5-flash
